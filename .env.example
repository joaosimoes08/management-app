DATABASE_URL=postgresql://simoes:change-me-local@localhost:5432/simoes
DOCKERHUB_NAMESPACE=joaosimoes08
APP_IMAGE_TAG=beta-1.0.4-release
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=COCiber
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=simoes-web
KEYCLOAK_REALM=COCiber
NEXT_PUBLIC_ORGANIZATION_NAME=COCiber
NEXT_PUBLIC_APP_LOCALE=pt-PT
KEYCLOAK_HOSTNAME=http://localhost:8080
NEXT_PUBLIC_BOOKSTACK_URL=
NEXT_PUBLIC_ZABBIX_URL=
NEXT_PUBLIC_ZAMMAD_URL=
NEXT_PUBLIC_ROCKETCHAT_URL=
NEXT_PUBLIC_ANSIBLE_URL=
POSTGRES_USER=simoes
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=simoes
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_REALM_FILE=./deploy/realm-cociber.generated.json
SNMP_KEYRING_HOST_FILE=./secrets/snmp-keyring.json
WEB_HOST=127.0.0.1
WEB_PORT=3000
API_HOST=127.0.0.1
API_PORT_HOST=3001
KEYCLOAK_HOST=127.0.0.1
KEYCLOAK_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
SNMP_HEALTH_HOST_PORT=3002
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
NGINX_CONFIG_FILE=./nginx/runtime.conf
REDIS_URL=redis://localhost:6379
AUTH_DISABLED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/COCiber
OIDC_BACKCHANNEL_URL=http://keycloak:8080/realms/COCiber
OIDC_AUDIENCE=simoes-api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (non-negative integer).
# Empty = the Compose default: 0 without the bundled nginx, 1 with docker-compose.proxy.yml.
# Leave 0 when clients reach the API directly, otherwise they can spoof the header and pick their own rate-limit key.
# Behind another proxy chain, set the exact number of proxies; never more than really exist.
TRUST_PROXY_HOPS=
KEYCLOAK_ADMIN_USERNAME=kc-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_REALM=COCiber
KEYCLOAK_ADMIN_CLIENT_ID=simoes-settings-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-settings-admin-secret
BOOTSTRAP_ADMIN_USERNAME=admin@admin.test
BOOTSTRAP_ADMIN_PASSWORD=
SNMP_DATABASE_URL=
SNMP_HOST_AGENT_DATABASE_URL=
# Step 31 (Microsoft Teams): public https base used for "Abrir na aplicação" links in Teams cards; empty = no link.
APP_PUBLIC_URL=
# Background Teams delivery poll, 1000–30000 ms (CRITICAL alerts are also sent immediately).
NOTIFICATION_DELIVERY_POLL_MS=15000
SNMP_INSTANCE_ID=snmp-01
SNMP_HOST_INSTANCE_ID=host-local
SNMP_HOST_AGENT_INTERVAL_SECONDS=30
SNMP_ROLE=all
SNMP_TRAP_PORT=1162
SNMP_HEALTH_PORT=3002
# SNMPv2c e SNMPv3 são aceites; SNMPv3 authPriv é o recomendado e SNMPv1 é sempre recusado. Define false para recusar v2c.
SNMP_ALLOW_V2C=true
# Host address and UDP port where the snmp container receives traps (published as <ip>:<port> -> 1162/udp).
# 0.0.0.0 = all host interfaces; set the management-LAN IP to limit the bind. Switches send traps to this IP and port.
SNMP_TRAP_HOST_IP=0.0.0.0
SNMP_TRAP_HOST_PORT=162
# IP address (IPv4 or IPv6, not a hostname) switches send traps to, shown in Settings > SNMP and "Configurar o switch"
# when there is no host agent. The switch ACL (permit host <addr>) needs an IP, so hostnames, 0.0.0.0, ::, 127.x and ::1
# are rejected. Empty = SNMP_TRAP_HOST_IP if it is a real IP; with 0.0.0.0 the UI asks you to set this.
SNMP_TRAP_PUBLIC_ADDRESS=
SNMP_KEYRING_FILE=./secrets/snmp-keyring.json
SNMP_TRAP_UNTRUSTED_ROWS_PER_MINUTE=120
SNMP_WORKER_CONCURRENCY=4
SNMP_METRICS_RETENTION_DAYS=90
SNMP_TRAP_RATE_LIMIT=120
SNMP_TRAP_SOURCE_LIMIT=10000
# Global per-minute cap (1-100000) on stored untrusted traps, SHARED by REJECTED rows (bad credential, v1, rate
# limited) and new UNMATCHED rows (unknown source); self-test traps do not count. Over the cap traps are dropped and
# only counted (snmp_trap_untrusted_rows_dropped_total, log SNMP_TRAP_UNTRUSTED_BUDGET), so under a flood the
# per-source alert occurrence counts undercount. REJECTED rows are kept 7 days, other trap rows 90 days.
SNMP_TRAP_UNTRUSTED_ROWS_PER_MINUTE=120
# Apenas para testes locais com NAT/hairpin do Docker Desktop. Manter false em producao.
SNMP_SELF_TEST_ENABLED=false
SNMP_SELF_TEST_PROXY_SOURCES=
SNMP_SELF_TEST_ALLOW_TRANSLATED_SOURCE=false
SNMP_SET_ENABLED=false

# Minutes without a Linux agent heartbeat before it is marked as late.
LINUX_AGENT_STALE_MINUTES=15
