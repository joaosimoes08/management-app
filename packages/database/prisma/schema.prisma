model Subnet {
  id                 String                   @id @default(uuid()) @db.Uuid
  cidr               String                   @unique
  version            Int
  gateway            String?
  purpose            String?
  environment        String?
  siteId             String?                  @db.Uuid
  vlanId             String?                  @db.Uuid
  site               Site?                    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  vlan               Vlan?                    @relation(fields: [vlanId], references: [id], onDelete: SetNull)
  ips                IpAddress[]
  capacitySnapshots  SubnetCapacitySnapshot[]
  discoveryJobs      DiscoveryJob[]
  discoverySchedule  DiscoverySchedule?
  vrfId              String?                  @db.Uuid
  parentSubnetId     String?                  @db.Uuid
  vrf                Vrf?                     @relation(fields: [vrfId], references: [id], onDelete: SetNull)
  parentSubnet       Subnet?                  @relation("SubnetHierarchy", fields: [parentSubnetId], references: [id], onDelete: SetNull)
  childSubnets       Subnet[]                 @relation("SubnetHierarchy")
  natSourceRules     NatRule[]                @relation("NatSourceSubnet")
  natTranslatedRules NatRule[]                @relation("NatTranslatedSubnet")
  tags               SubnetTag[]
  scanEnabled        Boolean                  @default(false)
  scanIntervalHours  Int                      @default(12)
  scanMethods        Json?
  scanTcpPorts       Json?
  reverseDnsEnabled  Boolean                  @default(true)
  /// Discovery P0: per-subnet scan load limits (null = worker default). Probes started per second and probes in flight.
  // Database CHECK constraints (migration 20261123160000_discovery_scan_limits), not expressible in Prisma:
  //   "Subnet_discoveryProbesPerSecond_range": NULL or 1–2000; "Subnet_discoveryMaxSockets_range": NULL or 1–1024.
  // `prisma migrate diff` does not see them; keep them when regenerating migrations.
  discoveryProbesPerSecond Int?
  discoveryMaxSockets      Int?
  /// D-P1a: optional SNMP enrichment. null = off (default). When set, every scan of this subnet tries only this READ
  /// credential, and only on hosts that answered ping or TCP in that scan. Deleting the credential turns it off.
  discoverySnmpCredentialId String?        @db.Uuid
  discoverySnmpCredential   SnmpCredential? @relation("SubnetDiscoverySnmpCredential", fields: [discoverySnmpCredentialId], references: [id], onDelete: SetNull)
  lastScanAt         DateTime?
  nextScanAt         DateTime?
  lastScanStatus     String?
  lastScanError      String?

  @@index([vlanId])
  @@index([siteId, vrfId, version])
  @@index([parentSubnetId])
  @@index([discoverySnmpCredentialId])
}

/// Step 36: site-scoped labels for devices and subnets. Names are unique per Site, case-insensitively (checked by the API).
