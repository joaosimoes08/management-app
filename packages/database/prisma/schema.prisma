/// A correction request raised by NEEDS_CORRECTION, owned by the group that reviews the asset type.
/// It is kept after it is resolved or rejected, so the history stays.
model CriticalAssetCorrection {
  id              String                        @id @default(uuid()) @db.Uuid
  attestationId   String                        @db.Uuid
