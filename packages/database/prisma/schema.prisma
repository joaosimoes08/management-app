enum CriticalityTier {
  T1
  T2
  T3
}

enum CriticalAssetOutcome {
  CONFIRMED
  NEEDS_CORRECTION
  NOT_FOUND
}

enum CriticalAssetCorrectionStatus {
  OPEN
  RESOLVED
  REJECTED
}

model CriticalAssetAttestation {
