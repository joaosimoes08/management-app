/// SNMP Phase 2 step 11: the neighbour discovery protocol an LldpObservation came from.
enum NeighborProtocol {
  LLDP
  CDP
}

model LldpObservation {
  id                     String        @id @default(uuid()) @db.Uuid
  deviceId               String        @db.Uuid
  snapshotId             String?       @db.Uuid
  source                 SourceType    @default(SNMP)
  /// SNMP Phase 2 step 11: LLDP, or the vendor protocol used where LLDP saw no neighbour on the port (CDP for Cisco).
  protocol               NeighborProtocol @default(LLDP)
  observedAt             DateTime      @default(now())
  confidence             Int
  localPortNumber        Int?
  localPortId            String?
  localPortDescription   String?
  remoteChassisIdSubtype Int?
  remoteChassisId        String?
  remotePortIdSubtype    Int?
  remotePortId           String?
  remotePortDescription  String?
  remoteSystemName       String?
  managementAddress      String?
  vlanId                 Int?
  bridgePort             Int?
  rawIdentifiers         Json
  resolvedDeviceId       String?       @db.Uuid
  device                 Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  snapshot               SnmpSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([deviceId, observedAt])
  @@index([resolvedDeviceId, observedAt])
}

