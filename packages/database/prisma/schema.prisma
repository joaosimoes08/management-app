  @@unique([pduId, outletIndex])
  @@unique([deviceId, plugIndex])
}

enum ScheduledReportFrequency {
  WEEKLY
  MONTHLY
}

/// Step 32: an ADMIN-defined weekly or monthly digest. Generated per recipient with that person's own permissions.
model ScheduledReport {
  id          String                     @id @default(uuid()) @db.Uuid
  name        String
  enabled     Boolean                    @default(true)
  frequency   ScheduledReportFrequency
  /// WEEKLY: 1 (Monday) to 7 (Sunday).
  dayOfWeek   Int?
  /// MONTHLY: 1 to 28, so every month has the day.
  dayOfMonth  Int?
  /// Local hour (0-23) in `timezone`.
  hour        Int
  timezone    String
  /// COMPLIANCE, LIFECYCLE, QUALITY, CAPACITY, CHANGES.
  sections    String[]
  /// Sites in the report; empty means every Site the recipient may read.
  siteIds     String[]                   @db.Uuid
  sendEmail   Boolean                    @default(true)
  /// One summary post (no figures) to the Teams operational alerts channel.
  sendTeams   Boolean                    @default(false)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  createdById String?                    @db.Uuid
  updatedById String?                    @db.Uuid
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  recipients  ScheduledReportRecipient[]
  runs        ScheduledReportRun[]

  @@index([enabled, nextRunAt])
}

/// A person who receives a report. `unsubscribedAt` is set from the e-mail link or the profile toggle.
model ScheduledReportRecipient {
  id               String          @id @default(uuid()) @db.Uuid
  reportId         String          @db.Uuid
  userId           String          @db.Uuid
  /// Random value in the e-mail unsubscribe link; it can only unsubscribe this person from this report.
  unsubscribeToken String          @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime        @default(now())
  report           ScheduledReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
}

/// One generation of a report for one period (scheduled or run on demand).
model ScheduledReportRun {
  id            String                  @id @default(uuid()) @db.Uuid
  reportId      String                  @db.Uuid
  /// SCHEDULE or MANUAL.
  trigger       String
  /// Local calendar dates (UTC midnight): start inclusive, end exclusive.
  periodStart   DateTime
  periodEnd     DateTime
  requestedById String?                 @db.Uuid
  createdAt     DateTime                @default(now())
  report        ScheduledReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  outputs       ScheduledReportOutput[]

  @@index([reportId, createdAt])
  @@index([createdAt])
}

/// What one recipient got from one run: only the Sites that person may read.
model ScheduledReportOutput {
  id         String                 @id @default(uuid()) @db.Uuid
  runId      String                 @db.Uuid
  userId     String?                @db.Uuid
  subject    String
  text       String
  html       String
  csv        String
  siteCount  Int
  createdAt  DateTime               @default(now())
  run        ScheduledReportRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  user       User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@index([runId])
}

/// Round 2 #13: one row per named background task (for example the critical-asset sweep). It holds the lease that keeps
/// a task to one run at a time across API replicas, and the record of the last run.
model BackgroundTaskRun {
  name           String    @id
  leaseOwner     String?
  leaseUntil     DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  /// RUNNING, COMPLETED or FAILED.
  lastStatus     String?
  lastError      String?
  lastDurationMs Int?
  lastSummary    Json?
  updatedAt      DateTime  @default(now()) @updatedAt
}
