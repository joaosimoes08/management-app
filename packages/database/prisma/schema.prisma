  @@index([scopeType, scopeId])
}

model DiscoveryJob {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  subnetId           String             @db.Uuid
  methods            Json
  tcpPorts           Json?
  reverseDns         Boolean            @default(true)
  status             DiscoveryJobStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  scannedCount       Int                @default(0)
  icmpReachableCount Int                @default(0)
  tcpReachableCount  Int                @default(0)
  reachableCount     Int                @default(0)
  unreachableCount   Int                @default(0)
  resultCount        Int                @default(0)
  /// Round 2 #10/#11: addresses to scan, addresses saved so far (resume cursor), probes sent, worker attempts.
  totalCount         Int                @default(0)
  processedCount     Int                @default(0)
  probeCount         Int                @default(0)
  attemptCount       Int                @default(0)
  /// Limits for this scan (null = the worker's default). stopReason: CANCELLED, LIMIT_DURATION or LIMIT_PROBES.
  maxDurationSeconds Int?
  maxProbes          Int?
  cancelRequestedAt  DateTime?
  stopReason         String?
  /// D-P1a: the READ credential this scan used for SNMP enrichment, fixed when the scan first starts (retries keep it).
  /// null = no enrichment. snmpSkippedReason says why enrichment did not run at all (e.g. SNMP_CREDENTIAL_UNAVAILABLE).
  snmpCredentialId   String?            @db.Uuid
  snmpCredential     SnmpCredential?    @relation("DiscoveryJobSnmpCredential", fields: [snmpCredentialId], references: [id], onDelete: SetNull)
  snmpEnrichedCount  Int                @default(0)
  snmpFailedCount    Int                @default(0)
  snmpSkippedReason  String?
  /// D-P2a: structured outcome counts over all scanned hosts (apps/api/src/discovery/discovery-outcome.ts,
  /// DiscoveryOutcomeCounts). null = run saved before D-P2a. Not scanned = totalCount - processedCount.
  outcomeCounts      Json?
  subnet             Subnet             @relation(fields: [subnetId], references: [id], onDelete: Cascade)
  results            DiscoveryResult[]
  createdAt          DateTime           @default(now())

  @@index([subnetId, createdAt])
  @@index([snmpCredentialId])
}

model DiscoveryResult {
  id            String                @id @default(uuid()) @db.Uuid
  jobId         String                @db.Uuid
  address       String
  hostname      String?
  icmpReachable Boolean               @default(false)
  responseMs    Int?
  openPorts     Json?
  /// D-P1a: SNMP enrichment outcome for this target, with per-field provenance (source SNMP, credentialId, observedAt).
  /// See apps/api/src/discovery/discovery-snmp.ts (DiscoverySnmpEnrichment). null = enrichment not attempted.
  snmp          Json?
  /// D-P2a: what each method saw for this host (ICMP, TCP per port, reverse DNS, SNMP). See discovery-outcome.ts
  /// (DiscoveryHostOutcome). null = saved before D-P2a.
  outcome       Json?
  status        DiscoveryResultStatus @default(PENDING)
  reviewedAt    DateTime?
  reviewedBy    String?               @db.Uuid
  job           DiscoveryJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())

  @@unique([jobId, address])
  @@index([status, createdAt])
}

