{
  "name": "@simoes/snmp",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "host-agent": "ts-node -r tsconfig-paths/register src/host-agent.ts",
    "host-agent:start": "node dist/host-agent.js",
    "test": "node --test -r ts-node/register src/**/*.spec.ts"
  },
  "dependencies": {
    "@simoes/database": "*",
    "@simoes/snmp-core": "*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.11.1",
    "net-snmp": "^3.26.3"
  },
  "devDependencies": {
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
