{
  "name": "simoes-mgmtapp",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "build": "pnpm --filter @simoes/database build && pnpm --filter @simoes/snmp-core build && pnpm --filter @simoes/api build && pnpm --filter @simoes/snmp build && pnpm --filter @simoes/web build",
    "start:dev": "dotenv -e .env -o -- pnpm --filter @simoes/database build && dotenv -e .env -o -- pnpm --filter @simoes/api start:dev",
    "worker:dev": "dotenv -e .env -o -- pnpm --filter @simoes/api worker:dev",
    "web:dev": "pnpm --filter @simoes/web dev",
    "web:build": "pnpm --filter @simoes/web build",
    "test:http": "pnpm --filter @simoes/api test:http",
    "db:generate": "dotenv -e .env -o -- pnpm --filter @simoes/database db:generate",
    "db:migrate:dev": "dotenv -e .env -o -- pnpm --filter @simoes/database db:migrate:dev",
    "db:migrate": "dotenv -e .env -o -- pnpm --filter @simoes/database db:migrate",
    "db:seed": "dotenv -e .env -o -- pnpm --filter @simoes/database db:seed",
    "db:studio": "dotenv -e .env -o -- pnpm --filter @simoes/database db:studio",
    "keycloak:provision-settings": "dotenv -e .env -o -- node infra/keycloak/provision-settings-admin.mjs",
    "qa:provision": "node scripts/provision-qa-users.mjs",
    "qa:scope": "node scripts/setup-qa-scope.mjs",
    "pilot:seed": "dotenv -e .env -o -- node scripts/seed-pilot.mjs",
    "pilot:baseline": "dotenv -e .env -o -- node scripts/pilot-baseline.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:deployment-config": "node --test deploy/configure-install.test.mjs",
    "snmp:keyring": "node scripts/generate-snmp-keyring.mjs",
    "snmp:host-agent": "dotenv -e .env -o -- pnpm --filter @simoes/snmp host-agent",
    "snmp:test-trap": "docker compose --profile snmp exec -T snmp node apps/snmp/dist/send-test-trap.js",
    "snmp:test-trap:host": "dotenv -e .env -o -- node apps/snmp/dist/send-test-trap.js --external",
    "test:snmp-lab": "bash e2e/snmp-trap-lab/lab.sh",
    "perf:baseline": "node scripts/performance/baseline.mjs"
  },
  "devDependencies": {
    "@nestjs/platform-fastify": "^11.2.12",
    "@nestjs/testing": "^11.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@simoes/database": "workspace:*",
    "@simoes/snmp-core": "workspace:*",
    "dotenv": "^17.4.1",
    "dotenv-cli": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.0"
  }
}
