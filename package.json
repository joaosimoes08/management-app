{
  "name": "simoes-mgmtapp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspace=@simoes/database && npm run build --workspace=@simoes/api && npm run build --workspace=@simoes/web",
    "start:dev": "dotenv -e .env -o -- npm run build --workspace=@simoes/database && dotenv -e .env -o -- npm run start:dev --workspace=@simoes/api",
    "worker:dev": "dotenv -e .env -o -- npm run worker:dev --workspace=@simoes/api",
    "web:dev": "npm run dev --workspace=@simoes/web",
    "web:build": "npm run build --workspace=@simoes/web",
    "db:generate": "dotenv -e .env -o -- npm run db:generate --workspace=@simoes/database",
    "db:migrate:dev": "dotenv -e .env -o -- npm run db:migrate:dev --workspace=@simoes/database",
    "db:migrate": "dotenv -e .env -o -- npm run db:migrate --workspace=@simoes/database",
    "db:seed": "dotenv -e .env -o -- npm run db:seed --workspace=@simoes/database",
    "db:studio": "dotenv -e .env -o -- npm run db:studio --workspace=@simoes/database"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
