{
  "name": "simoes-mgmtapp",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspace=@simoes/database && npm run build --workspace=@simoes/snmp-core && npm run build --workspace=@simoes/api && npm run build --workspace=@simoes/snmp && npm run build --workspace=@simoes/web",
    "start:dev": "dotenv -e .env -o -- npm run build --workspace=@simoes/database && dotenv -e .env -o -- npm run start:dev --workspace=@simoes/api",
    "worker:dev": "dotenv -e .env -o -- npm run worker:dev --workspace=@simoes/api",
    "web:dev": "npm run dev --workspace=@simoes/web",
    "web:build": "npm run build --workspace=@simoes/web",
    "test:http": "npm run test:http --workspace=@simoes/api",
    "db:generate": "dotenv -e .env -o -- npm run db:generate --workspace=@simoes/database",
    "db:migrate:dev": "dotenv -e .env -o -- npm run db:migrate:dev --workspace=@simoes/database",
    "db:migrate": "dotenv -e .env -o -- npm run db:migrate --workspace=@simoes/database",
    "db:seed": "dotenv -e .env -o -- npm run db:seed --workspace=@simoes/database",
    "db:studio": "dotenv -e .env -o -- npm run db:studio --workspace=@simoes/database",
    "keycloak:provision-settings": "dotenv -e .env -o -- node infra/keycloak/provision-settings-admin.mjs",
    "qa:provision": "node scripts/provision-qa-users.mjs",
    "qa:scope": "node scripts/setup-qa-scope.mjs",
    "pilot:seed": "dotenv -e .env -o -- node scripts/seed-pilot.mjs",
    "pilot:baseline": "dotenv -e .env -o -- node scripts/pilot-baseline.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "snmp:keyring": "node scripts/generate-snmp-keyring.mjs",
    "snmp:host-agent": "dotenv -e .env -o -- npm run host-agent --workspace=@simoes/snmp",
    "snmp:test-trap": "docker compose --profile snmp exec -T snmp node apps/snmp/dist/send-test-trap.js",
    "snmp:test-trap:host": "dotenv -e .env -o -- node apps/snmp/dist/send-test-trap.js --external"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  }
}
